# Amadeus API credentials
AMADEUS_CLIENT_ID=your_client_id
AMADEUS_CLIENT_SECRET=your_client_secret
# Choose between `test` (sandbox) or `production`
AMADEUS_ENV=test
# Preferred currency for returned fares (ISO 4217)
CURRENCY=EUR
# Directory where JSON snapshots will be stored
DATA_DIR=.data
# Comma separated storage backend list
STORAGE_BACKENDS=json
# Comma separated notification channels (email,telegram,custom)
NOTIFICATION_CHANNELS=

# Routes are comma separated ORIGIN-DESTINATION airport code pairs
ROUTES=MNL-TYO,MNL-KIX

# Shared travel party info
ADULTS=2
CHILDREN=1

# Travel dates (YYYY-MM-DD)
DEPARTURE_DATE=2024-08-01
# Leave blank to search one-way itineraries
RETURN_DATE=

# Accepts economy,business or the keyword `all`
TRAVEL_CLASSES=all

# Email notification settings (used when enabling the `email` channel)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=username
EMAIL_PASSWORD=password
EMAIL_USE_TLS=true
EMAIL_FROM=alerts@example.com
EMAIL_TO=person@example.com,another@example.com
EMAIL_SUBJECT_PREFIX=[Flight Tracker]

# Telegram notification settings (used when enabling the `telegram` channel)
TELEGRAM_BOT_TOKEN=123456:bot-token
TELEGRAM_CHAT_IDS=-1001234567890
