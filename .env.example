# Amadeus API credentials
AMADEUS_CLIENT_ID=your_client_id
AMADEUS_CLIENT_SECRET=your_client_secret
# Choose between `test` (sandbox) or `production`
AMADEUS_ENV=test
# Preferred currency for returned fares (ISO 4217)
CURRENCY=EUR

# Routes are comma separated ORIGIN-DESTINATION airport code pairs
ROUTES=MNL-TYO,MNL-KIX

# Shared travel party info
ADULTS=2
CHILDREN=1

# Travel dates (YYYY-MM-DD)
DEPARTURE_DATE=2024-08-01
# Leave blank to search one-way itineraries
RETURN_DATE=

# Accepts economy,business or the keyword `all`
TRAVEL_CLASSES=all
